{
  "name": "AFL-andon",
  "version": "1.0.0",
  "description": "AFL server command app / Andon board",
  "main": "main.js",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && npm rebuild ssh2 && install-electron && node scripts/install.js",
    "setup": "node scripts/install.js",
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "check-package": "node scripts/validate-package.js",
    "test": "node --test test/*.test.js tiled/browser/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbeaucage/AFL-andon.git"
  },
  "author": {
    "name": "Peter Beaucage",
    "email": "peter.beaucage@nist.gov"
  },
  "license": "NIST-PD-fallback",
  "bugs": {
    "url": "https://github.com/pbeaucage/AFL-andon/issues"
  },
  "homepage": "https://github.com/pbeaucage/AFL-andon#readme",
  "engines": {
    "node": "26.13.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-log": "^5.2.4",
    "fs-extra": "^11.3.0",
    "js-yaml": "^4.3.2",
    "jsoneditor": "^10.2.0",
    "node-fetch": "^3.3.2",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.0.12",
    "patch-package": "8.0.1"
  },
  "overrides": {
    "nan": "2.30.0"
  },
  "build": {
    "appId": "gov.nist.AFL-andon",
    "productName": "AFL Andon",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!node_modules/cpu-features/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/mac/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/win/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icons/png/512x512.png",
      "category": "Utility"
    }
  }
}
